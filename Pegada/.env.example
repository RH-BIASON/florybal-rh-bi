PORT=4001
PYTHON_BIN=python

# Optional: enable Supabase persistence.
# The app keeps working with local data/payroll.json when these values are empty.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PEGADA_SUPABASE_STORAGE_BUCKET=pegada-payroll-pdfs

# Optional. Leave disabled for the compact production setup: the active dataset
# is stored once as a compressed snapshot and PDFs remain in Storage.
SUPABASE_WRITE_ANALYTICS_TABLES=false
